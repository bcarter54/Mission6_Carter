@model Movie

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

@* Use form to gather and submit info for new movie submission*@

<h2>Add a Movie</h2>

<form method="post">
    <input type="hidden" asp-for="MovieId" value="@Model.MovieId">
    <label asp-for="Category">Category: </label>
    <select asp-for="CategoryId" required>
        <option value="">--Select a Category--</option>
        @foreach (Category cat in ViewBag.Categories)
        {
            <option value="@cat.CategoryId">@cat.CategoryName</option>
        }
    </select>

    <br><br>

    <label asp-for="Title">Title: </label>
    <input type="text" asp-for="Title" required>

    <br><br>

    <label asp-for="Year">Year: </label>
    <input type="number" asp-for="Year" required>

    <br><br>

    <label asp-for="Director">Director: </label>
    <input type="text" asp-for="Director" required>

    <br><br>

    <label asp-for="Rating">Rating: </label>
    <select asp-for="Rating" required>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>

    <br><br>

    <label asp-for="Edited">Edited: </label>
    <select asp-for="Edited">
        <option value="false">No</option>
        <option value="true">Yes</option>
    </select>

    <br><br>

    <label asp-for="LentTo">Lent to: </label>
    <input type="text" asp-for="LentTo">

    <br><br>

    <label asp-for="CopiedToPlex">Copied to Plex? </label>
    <select asp-for="CopiedToPlex">
        <option value="false">No</option>
        <option value="true">Yes</option>
    </select>

    <br><br>

    <label asp-for="Notes">Notes: </label>
    <textarea cols="25" rows="1" maxlength="25" asp-for="Notes"></textarea>

    <br><br>
    <button type="submit">Submit Movie</button>

    <div asp-validation-summary="All"></div>
</form>